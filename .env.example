# Postgres connection string. On Vercel, add a Postgres database in the
# Storage tab and this is provided automatically.
DATABASE_URL=

# Photo storage. On Vercel, add a Blob store in the Storage tab and connect
# it to the project; this is then injected at build time, so a deployment
# built before the store was connected won't have it and photo uploads will
# fail until you redeploy. Locally it has to come from `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
